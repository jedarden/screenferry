{
  "name": "screenferry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "gate:numbers": "python3 docs/research/sim/ge_cost_model.py --check",
    "gate:g3": "node scripts/gate-g3.mjs",
    "gate": "npm run typecheck && npm run lint && npm run test && npm run gate:numbers && npm run gate:g3"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "zxing-wasm": "1.2.11"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "@typescript-eslint/eslint-plugin": "8.65.0",
    "@typescript-eslint/parser": "8.65.0",
    "eslint": "10.8.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "24.1.3",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}

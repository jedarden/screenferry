{
  "name": "screenferry",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate:numbers": "python3 docs/research/sim/ge_cost_model.py --check",
    "gate": "npm run typecheck && npm run test && npm run gate:numbers"
  },
  "dependencies": {
    "qrcode": "1.5.4",
    "zxing-wasm": "1.2.11"
  },
  "devDependencies": {
    "@types/node": "22.9.0",
    "@types/qrcode": "1.5.5",
    "typescript": "5.6.3",
    "vite": "5.4.10",
    "vitest": "2.1.4"
  }
}
